<?xml version="1.0" encoding="UTF-8"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="form-action">
            <values>
                <value id="moloni_plugins" type="host">plugins.moloni.com</value>
                <value id="moloni_api" type="host">api.moloni.pt</value>
                <value id="moloni_www" type="host">www.moloni.pt</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="moloni_plugins" type="host">plugins.moloni.com</value>
                <value id="moloni_api" type="host">api.moloni.pt</value>
                <value id="moloni_www" type="host">www.moloni.pt</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="moloni_plugins" type="host">plugins.moloni.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
